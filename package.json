{
  "name": "darkx-launcher",
  "productName": "DarkX Launcher",
  "version": "1.1.3",
  "description": "Лаунчер Minecraft с автоустановкой Fabric и DarkX Visuals",
  "main": "main/main.js",
  "author": "DarkX",
  "license": "UNLICENSED",
  "private": true,
  "scripts": {
    "css": "tailwindcss -i renderer/input.css -o renderer/style.css --minify",
    "start": "npm run css && electron .",
    "test": "node test/run.js && node test/importers.js && node test/ely.js",
    "test:net": "electron test/nettest.js",
    "dist": "npm run css && electron-builder --win"
  },
  "dependencies": {
    "adm-zip": "0.5.10",
    "sql.js": "^1.8.0"
  },
  "devDependencies": {
    "electron": "20.3.12",
    "electron-builder": "23.6.0",
    "tailwindcss": "3.4.1"
  },
  "build": {
    "appId": "dev.darkx.launcher",
    "productName": "DarkX Launcher",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main/**/*",
      "renderer/**/*",
      "assets/**/*",
      "launcher.config.json",
      "launcher.local.json",
      "package.json",
      "!renderer/input.css"
    ],
    "portable": {
      "artifactName": "DarkX-Launcher-${version}.${ext}"
    },
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64",
            "ia32"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "artifactName": "DarkX-Launcher-Setup-${version}-${arch}.${ext}",
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "perMachine": false
    }
  }
}
